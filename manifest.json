{
  "manifest_version": 2,
  "name": "FPS Arena Combat Suite (LibreWolf)",
  "version": "2.9.11",
  "description": "FPS Arena v2.9.11: bounded early firing-window search and server-confirmed first-shot timing; default autopilot unchanged.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://fps-arena-rosy.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://fps-arena-rosy.vercel.app/*"
      ],
      "js": [
        "domain-utils.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_action": {
    "default_title": "FPS Arena Combat Suite",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "fps-arena-aim@local.dev"
    }
  },
  "optional_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "domain-utils.js",
      "background.js"
    ],
    "persistent": true
  }
}
